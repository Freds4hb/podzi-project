# =============================================================================
# Podzi.ai platform — environment variables
# =============================================================================
# Copy this file to `.env.local` for local development and fill in real values.
# NEVER commit `.env.local` or paste real keys into chat/PRs/commits.
# On Vercel, set these in Project Settings → Environment Variables.
#
# Each block below powers one integration adapter in src/lib/integrations/.
# The admin dashboard (/admin) reads these to report per-service status.
# =============================================================================

# --- Database: Neon Postgres --------------------------------------------------
# Use the POOLED connection string for serverless (…-pooler.neon.tech).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Optional direct (unpooled) URL for migrations, if you prefer to separate them.
DATABASE_URL_UNPOOLED=""

# --- Authentication: Clerk ----------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Where Clerk sends users for auth flows (defaults are fine for most apps).
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# --- Payments: Stripe ---------------------------------------------------------
STRIPE_SECRET_KEY=""
# Signing secret for the /api/stripe/webhook endpoint (from the Stripe CLI or
# the Dashboard webhook config). Used to verify webhook authenticity.
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Workflow automation: n8n (optional, ops automation only) -----------------
# Base URL of your n8n instance and an API key for admin status checks.
N8N_BASE_URL=""
N8N_API_KEY=""

# --- Hosting/infra: Vercel (optional, for admin status checks) ----------------
# A Vercel access token lets the admin page report deployment status. Read-only
# scope is sufficient. Optional VERCEL_PROJECT_ID / VERCEL_TEAM_ID to scope it.
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""

# --- Podcast identification: Podcast Index (optional) -------------------------
# Directory SEARCH uses Podcast Index. Generate a free key/secret at
# https://api.podcastindex.org. Leave blank to run without search — adding a show
# by pasting its RSS feed URL needs no credentials at all.
PODCAST_INDEX_API_KEY=""
PODCAST_INDEX_API_SECRET=""

# --- Podcast concatenation pipeline ------------------------------------------
# Transcription + summarization providers for the direct-code concat engine.
# Provider-agnostic (OpenAI-compatible). Leave keys blank to run the pipeline in
# audio-only mode (stitched audio still produced; summaries/smart-trim skipped).
TRANSCRIPTION_API_KEY=""
TRANSCRIPTION_BASE_URL="https://api.openai.com/v1"   # or a self-hosted Whisper
TRANSCRIPTION_MODEL="whisper-1"
SUMMARIZATION_API_KEY=""
SUMMARIZATION_BASE_URL="https://api.openai.com/v1"
SUMMARIZATION_MODEL="gpt-4o-mini"

# Object storage for stitched audio + cached transcripts. Cloudflare R2 is the
# recommended default (zero egress at scale). Leave blank to use local disk
# (.storage/) in development. S3-compatible credentials:
AUDIO_STORAGE_ENDPOINT=""            # e.g. https://<account>.r2.cloudflarestorage.com
AUDIO_STORAGE_BUCKET=""
AUDIO_STORAGE_ACCESS_KEY_ID=""
AUDIO_STORAGE_SECRET_ACCESS_KEY=""
AUDIO_STORAGE_REGION="auto"          # R2 uses "auto"; S3 uses a real region
AUDIO_STORAGE_PUBLIC_URL=""          # public/CDN base URL objects are served from

# Optional: override ffmpeg/ffprobe binary paths for the worker.
FFMPEG_PATH=""
FFPROBE_PATH=""

# --- App ----------------------------------------------------------------------
# Public base URL of this deployment (used to build absolute links/callbacks).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
